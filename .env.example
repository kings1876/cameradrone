# Reply portal (server-side only — set these in Vercel → Project → Settings → Environment Variables, never commit real values)

# Admin passcode for https://dronesonsale.com.au/admin  (required — admin returns 503 without it)
ADMIN_PASSCODE=

# SMTP (all email: order notifications, customer confirmations, payment details, replies)
# Zoho Mail (Australia data centre) example:
SMTP_HOST=smtp.zoho.com.au
SMTP_PORT=465
SMTP_USER=contact@dronesonsale.com.au
SMTP_PASS=
SMTP_FROM="Camera Drones Australia <contact@dronesonsale.com.au>"

# Where shop notifications go (each optional; falls back to koloonjo@gmail.com)
CONTACT_EMAIL=
ORDER_EMAIL=
WHOLESALE_EMAIL=

# Storage: connect Upstash Redis from Vercel → Storage → Create (adds the KV_REST_API_* / UPSTASH_REDIS_REST_* variables automatically)

# Optional: GEMINI_API_KEY for the chat widget
GEMINI_API_KEY=
